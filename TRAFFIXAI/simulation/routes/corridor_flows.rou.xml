<?xml version="1.0" encoding="UTF-8"?>
<!--
  TRAFFIX AI - Traffic Route and Flow Definitions
  Generates realistic heterogeneous traffic flows along the corridor and cross streets
-->
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    <!-- Include vehicle type definitions -->
    <vType id="car" vClass="passenger" length="4.5" width="1.8" maxSpeed="33.33" accel="2.6" decel="4.5" sigma="0.5" minGap="2.5" guiShape="passenger" emissionClass="HBEFA3/PC_G_EU4" color="0.2,0.6,1.0"/>
    <vType id="motorcycle" vClass="motorcycle" length="2.2" width="0.9" maxSpeed="38.89" accel="3.2" decel="5.0" sigma="0.5" minGap="1.5" guiShape="motorcycle" emissionClass="HBEFA3/LDV_G_EU4" color="1.0,0.8,0.0"/>
    <vType id="bus" vClass="bus" length="12.0" width="2.5" maxSpeed="22.22" accel="1.2" decel="3.5" sigma="0.4" minGap="3.0" guiShape="bus" emissionClass="HBEFA3/Bus" color="0.2,0.85,0.3"/>
    <vType id="truck" vClass="truck" length="10.0" width="2.5" maxSpeed="20.0" accel="1.3" decel="3.5" sigma="0.4" minGap="3.5" guiShape="truck" emissionClass="HBEFA3/HDV_D_EU4" color="0.9,0.3,0.3"/>

    <!-- Corridor Routes -->
    <route id="r_WE" edges="W_to_J1 J1_to_J2 J2_to_J3 J3_to_E"/>
    <route id="r_EW" edges="E_to_J3 J3_to_J2 J2_to_J1 J1_to_W"/>

    <!-- Cross Street Routes (North-South Through) -->
    <route id="r_NS_1" edges="N1_to_J1 J1_to_S1"/>
    <route id="r_SN_1" edges="S1_to_J1 J1_to_N1"/>
    <route id="r_NS_2" edges="N2_to_J2 J2_to_S2"/>
    <route id="r_SN_2" edges="S2_to_J2 J2_to_N2"/>
    <route id="r_NS_3" edges="N3_to_J3 J3_to_S3"/>
    <route id="r_SN_3" edges="S3_to_J3 J3_to_N3"/>

    <!-- Turning Movements onto Corridor -->
    <route id="r_N1_E" edges="N1_to_J1 J1_to_J2 J2_to_J3 J3_to_E"/>
    <route id="r_S1_E" edges="S1_to_J1 J1_to_J2 J2_to_J3 J3_to_E"/>
    <route id="r_N2_E" edges="N2_to_J2 J2_to_J3 J3_to_E"/>
    <route id="r_S2_E" edges="S2_to_J2 J2_to_J3 J3_to_E"/>

    <!-- ==================== FLOWS (0 to 3600s) ==================== -->

    <!-- Primary Arterial Inflow (West to East) - Heavy corridor demand to evaluate spillback -->
    <flow id="f_car_WE" route="r_WE" type="car" begin="0" end="3600" vehsPerHour="800" departLane="best" departSpeed="max"/>
    <flow id="f_moto_WE" route="r_WE" type="motorcycle" begin="0" end="3600" vehsPerHour="250" departLane="best" departSpeed="max"/>
    <flow id="f_bus_WE" route="r_WE" type="bus" begin="0" end="3600" vehsPerHour="80" departLane="best" departSpeed="max"/>
    <flow id="f_truck_WE" route="r_WE" type="truck" begin="0" end="3600" vehsPerHour="70" departLane="best" departSpeed="max"/>

    <!-- Counter Arterial Inflow (East to West) - Moderate demand -->
    <flow id="f_car_EW" route="r_EW" type="car" begin="0" end="3600" vehsPerHour="500" departLane="best" departSpeed="max"/>
    <flow id="f_moto_EW" route="r_EW" type="motorcycle" begin="0" end="3600" vehsPerHour="150" departLane="best" departSpeed="max"/>
    <flow id="f_bus_EW" route="r_EW" type="bus" begin="0" end="3600" vehsPerHour="40" departLane="best" departSpeed="max"/>
    <flow id="f_truck_EW" route="r_EW" type="truck" begin="0" end="3600" vehsPerHour="40" departLane="best" departSpeed="max"/>

    <!-- Cross Street Flows at J1 -->
    <flow id="f_cross_j1_ns" route="r_NS_1" type="car" begin="0" end="3600" vehsPerHour="180" departLane="best"/>
    <flow id="f_cross_j1_sn" route="r_SN_1" type="car" begin="0" end="3600" vehsPerHour="180" departLane="best"/>
    <flow id="f_turn_j1_n1" route="r_N1_E" type="car" begin="0" end="3600" vehsPerHour="80" departLane="best"/>

    <!-- Cross Street Flows at J2 (Center bottleneck) -->
    <flow id="f_cross_j2_ns" route="r_NS_2" type="car" begin="0" end="3600" vehsPerHour="250" departLane="best"/>
    <flow id="f_cross_j2_sn" route="r_SN_2" type="car" begin="0" end="3600" vehsPerHour="250" departLane="best"/>
    <flow id="f_cross_j2_bus" route="r_NS_2" type="bus" begin="0" end="3600" vehsPerHour="30" departLane="best"/>
    <flow id="f_turn_j2_n2" route="r_N2_E" type="car" begin="0" end="3600" vehsPerHour="90" departLane="best"/>

    <!-- Cross Street Flows at J3 -->
    <flow id="f_cross_j3_ns" route="r_NS_3" type="car" begin="0" end="3600" vehsPerHour="200" departLane="best"/>
    <flow id="f_cross_j3_sn" route="r_SN_3" type="car" begin="0" end="3600" vehsPerHour="200" departLane="best"/>
</routes>
