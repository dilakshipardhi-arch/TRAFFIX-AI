<?xml version="1.0" encoding="UTF-8"?>
<!--
  TRAFFIX AI - Turning and Lane Connection Definitions
-->
<connections xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/connections_file.xsd">
    <!-- J1: Corridor Connections -->
    <connection from="W_to_J1" to="J1_to_J2" fromLane="0" toLane="0"/>
    <connection from="W_to_J1" to="J1_to_J2" fromLane="1" toLane="1"/>
    <connection from="W_to_J1" to="J1_to_S1" fromLane="0" toLane="0"/>
    <connection from="W_to_J1" to="J1_to_N1" fromLane="1" toLane="0"/>

    <connection from="J2_to_J1" to="J1_to_W" fromLane="0" toLane="0"/>
    <connection from="J2_to_J1" to="J1_to_W" fromLane="1" toLane="1"/>
    <connection from="J2_to_J1" to="J1_to_N1" fromLane="0" toLane="0"/>
    <connection from="J2_to_J1" to="J1_to_S1" fromLane="1" toLane="0"/>

    <!-- J1: Cross Street Connections -->
    <connection from="N1_to_J1" to="J1_to_S1" fromLane="0" toLane="0"/>
    <connection from="N1_to_J1" to="J1_to_W" fromLane="0" toLane="0"/>
    <connection from="N1_to_J1" to="J1_to_J2" fromLane="0" toLane="1"/>

    <connection from="S1_to_J1" to="J1_to_N1" fromLane="0" toLane="0"/>
    <connection from="S1_to_J1" to="J1_to_J2" fromLane="0" toLane="0"/>
    <connection from="S1_to_J1" to="J1_to_W" fromLane="0" toLane="1"/>

    <!-- J2: Corridor Connections -->
    <connection from="J1_to_J2" to="J2_to_J3" fromLane="0" toLane="0"/>
    <connection from="J1_to_J2" to="J2_to_J3" fromLane="1" toLane="1"/>
    <connection from="J1_to_J2" to="J2_to_S2" fromLane="0" toLane="0"/>
    <connection from="J1_to_J2" to="J2_to_N2" fromLane="1" toLane="0"/>

    <connection from="J3_to_J2" to="J2_to_J1" fromLane="0" toLane="0"/>
    <connection from="J3_to_J2" to="J2_to_J1" fromLane="1" toLane="1"/>
    <connection from="J3_to_J2" to="J2_to_N2" fromLane="0" toLane="0"/>
    <connection from="J3_to_J2" to="J2_to_S2" fromLane="1" toLane="0"/>

    <!-- J2: Cross Street Connections -->
    <connection from="N2_to_J2" to="J2_to_S2" fromLane="0" toLane="0"/>
    <connection from="N2_to_J2" to="J2_to_J1" fromLane="0" toLane="0"/>
    <connection from="N2_to_J2" to="J2_to_J3" fromLane="0" toLane="1"/>

    <connection from="S2_to_J2" to="J2_to_N2" fromLane="0" toLane="0"/>
    <connection from="S2_to_J2" to="J2_to_J3" fromLane="0" toLane="0"/>
    <connection from="S2_to_J2" to="J2_to_J1" fromLane="0" toLane="1"/>

    <!-- J3: Corridor Connections -->
    <connection from="J2_to_J3" to="J3_to_E" fromLane="0" toLane="0"/>
    <connection from="J2_to_J3" to="J3_to_E" fromLane="1" toLane="1"/>
    <connection from="J2_to_J3" to="J3_to_S3" fromLane="0" toLane="0"/>
    <connection from="J2_to_J3" to="J3_to_N3" fromLane="1" toLane="0"/>

    <connection from="E_to_J3" to="J3_to_J2" fromLane="0" toLane="0"/>
    <connection from="E_to_J3" to="J3_to_J2" fromLane="1" toLane="1"/>
    <connection from="E_to_J3" to="J3_to_N3" fromLane="0" toLane="0"/>
    <connection from="E_to_J3" to="J3_to_S3" fromLane="1" toLane="0"/>

    <!-- J3: Cross Street Connections -->
    <connection from="N3_to_J3" to="J3_to_S3" fromLane="0" toLane="0"/>
    <connection from="N3_to_J3" to="J3_to_J2" fromLane="0" toLane="0"/>
    <connection from="N3_to_J3" to="J3_to_E" fromLane="0" toLane="1"/>

    <connection from="S3_to_J3" to="J3_to_N3" fromLane="0" toLane="0"/>
    <connection from="S3_to_J3" to="J3_to_E" fromLane="0" toLane="0"/>
    <connection from="S3_to_J3" to="J3_to_J2" fromLane="0" toLane="1"/>
</connections>
