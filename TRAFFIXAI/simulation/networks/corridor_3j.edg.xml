<?xml version="1.0" encoding="UTF-8"?>
<!--
  TRAFFIX AI - Edge (Road Link) Definitions
  Speed limits: Corridor = 50 km/h (13.89 m/s), Cross streets = 40 km/h (11.11 m/s)
-->
<edges xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/edges_file.xsd">
    <!-- Main Corridor: West to East (Downstream Progression) -->
    <edge id="W_to_J1" from="W_in" to="J1" numLanes="2" speed="13.89" priority="3"/>
    <edge id="J1_to_J2" from="J1" to="J2" numLanes="2" speed="13.89" priority="3"/>
    <edge id="J2_to_J3" from="J2" to="J3" numLanes="2" speed="13.89" priority="3"/>
    <edge id="J3_to_E" from="J3" to="E_out" numLanes="2" speed="13.89" priority="3"/>

    <!-- Main Corridor: East to West (Counter-flow) -->
    <edge id="E_to_J3" from="E_out" to="J3" numLanes="2" speed="13.89" priority="3"/>
    <edge id="J3_to_J2" from="J3" to="J2" numLanes="2" speed="13.89" priority="3"/>
    <edge id="J2_to_J1" from="J2" to="J1" numLanes="2" speed="13.89" priority="3"/>
    <edge id="J1_to_W" from="J1" to="W_in" numLanes="2" speed="13.89" priority="3"/>

    <!-- Cross Streets at Intersection J1 -->
    <edge id="N1_to_J1" from="N1" to="J1" numLanes="1" speed="11.11" priority="2"/>
    <edge id="J1_to_N1" from="J1" to="N1" numLanes="1" speed="11.11" priority="2"/>
    <edge id="S1_to_J1" from="S1" to="J1" numLanes="1" speed="11.11" priority="2"/>
    <edge id="J1_to_S1" from="J1" to="S1" numLanes="1" speed="11.11" priority="2"/>

    <!-- Cross Streets at Intersection J2 -->
    <edge id="N2_to_J2" from="N2" to="J2" numLanes="1" speed="11.11" priority="2"/>
    <edge id="J2_to_N2" from="J2" to="N2" numLanes="1" speed="11.11" priority="2"/>
    <edge id="S2_to_J2" from="S2" to="J2" numLanes="1" speed="11.11" priority="2"/>
    <edge id="J2_to_S2" from="J2" to="S2" numLanes="1" speed="11.11" priority="2"/>

    <!-- Cross Streets at Intersection J3 -->
    <edge id="N3_to_J3" from="N3" to="J3" numLanes="1" speed="11.11" priority="2"/>
    <edge id="J3_to_N3" from="J3" to="N3" numLanes="1" speed="11.11" priority="2"/>
    <edge id="S3_to_J3" from="S3" to="J3" numLanes="1" speed="11.11" priority="2"/>
    <edge id="J3_to_S3" from="J3" to="S3" numLanes="1" speed="11.11" priority="2"/>
</edges>
